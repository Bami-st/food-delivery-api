# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (SQLite for local dev, PostgreSQL for production on Neon/Supabase/Render/Vercel)
DATABASE_URL="file:./dev.db"

# Rate Limiting Configuration (Stage 5)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optional Upstash Redis for Vercel Serverless Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Pagination Defaults (Stage 3 & Stage 5)
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
