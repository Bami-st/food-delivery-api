# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL for Render / Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/food_delivery?sslmode=disable"

# Rate Limiting Configuration (Stage 5)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination Defaults (Stage 3 & Stage 5)
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
